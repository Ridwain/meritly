# Copy this file to ".env.local" and fill in the real values.
# ".env.local" is git-ignored, so your secrets never get committed.

# --- Supabase ---
# Project URL and anon (public) key.
# Find these in the Supabase dashboard: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://zovgrzqzdabxmwtxrake.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service-role key: full access, BYPASSES row-level security. Server-only —
# never expose to the browser. Used by the invite API route.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Google Gemini (used in Feature 10 for AI performance summaries) ---
# Get a key at https://aistudio.google.com/app/apikey
# Server-only: no NEXT_PUBLIC_ prefix, so it never reaches the browser.
GEMINI_API_KEY=your-gemini-api-key-here
