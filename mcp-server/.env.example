# Copy to .env for local MCP development. Never commit the real file.
MCP_ENVIRONMENT=development
MCP_BASE_URL=http://localhost:8000
NEXT_APP_BASE_URL=http://localhost:3000

SUPABASE_PROJECT_URL=https://zovgrzqzdabxmwtxrake.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-legacy-anon-key
SUPABASE_OAUTH_CLIENT_ID=register-the-meritly-mcp-gateway-in-supabase
SUPABASE_OAUTH_CLIENT_SECRET=keep-this-server-side-only

# Generate independent high-entropy values. Do not reuse the OAuth secret.
MCP_JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
# Fernet key: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MCP_STORAGE_ENCRYPTION_KEY=replace-with-a-valid-fernet-key

# Production must use persistent, authenticated Redis/Valkey with TLS.
REDIS_URL=redis://localhost:6379/0
